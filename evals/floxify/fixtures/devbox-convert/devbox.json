{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.13.0/.schema/devbox.schema.json",
  "packages": [
    "nodejs@20",
    "python@3.12",
    "jq@latest"
  ],
  "env": {
    "NODE_ENV": "development"
  },
  "shell": {
    "init_hook": [
      "echo 'Welcome to the devbox shell'",
      "npm install"
    ],
    "scripts": {
      "test": "npm test"
    }
  }
}
