{
  "name": "orders-api",
  "version": "1.0.0",
  "description": "Small API service backed by PostgreSQL",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node scripts/migrate.js",
    "db:dump": "pg_dump -h target/dev-db-socket -U orders -s orders_development > db/schema.sql"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}
